{
  "name": "champ-select-assistant",
  "version": "0.6.4",
  "description": "Asystent wyboru postaci do League of Legends",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "mock": "node mock/mock-lcu.js",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "pl.daniel.champselectassistant",
    "productName": "Champ Select Assistant",
    "files": [
      "src/**",
      "data/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "ChampSelectAssistant-portable.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "ChampSelectAssistant-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kardapan-alt",
        "repo": "champ-select-assistant",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kardapan-alt/champ-select-assistant.git"
  }
}
